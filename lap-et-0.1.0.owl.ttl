@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix lapet: <https://w3id.org/lap-et#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .

# Optional alignment hooks (not required to use LAP-ET)
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .

#################################################################
# Ontology header
#################################################################

lapet: a owl:Ontology ;
  rdfs:label "LAP-ET: LAP Experimental Techniques Ontology"@en ;
  rdfs:comment "Core ontology for describing LAP experimental technique types, specifications (templates), variable semantics, relations, and channel assignments. Includes SHACL shapes for validating IV 2-point and 4-point configurations."@en ;
  owl:versionInfo "0.1.0" .

#################################################################
# Core classes
#################################################################

lapet:Experiment a owl:Class ;
  rdfs:label "Experiment"@en ;
  rdfs:comment "An experiment (often instantiated as an ExperimentRun) performed on a device/sample."@en .

lapet:ExperimentRun a owl:Class ;
  rdfs:subClassOf lapet:Experiment ;
  rdfs:label "Experiment run"@en ;
  rdfs:comment "A concrete execution of an experiment, with a selected specification and channel assignments."@en .

lapet:ExperimentType a owl:Class ;
  rdfs:label "Experiment type"@en ;
  rdfs:comment "A type of experiment/technique (e.g., IV, Hall, optical). Often used to drive template selection."@en .

lapet:MeasurementSpecification a owl:Class ;
  rdfs:label "Measurement specification"@en ;
  rdfs:comment "A specification/template variant of an experiment type (e.g., 2-point IV vs 4-point IV). Used to define required semantics and parameters."@en .

lapet:Variable a owl:Class ;
  rdfs:label "Variable"@en ;
  rdfs:comment "A semantic variable used in an experiment (control variable, observable, or parameter). Channels can be assigned to variables."@en .

lapet:ControlVariable a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Control variable"@en ;
  rdfs:comment "A variable that is controlled or set (swept or fixed) during a run (e.g., applied voltage)."@en .

lapet:Observable a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Observable"@en ;
  rdfs:comment "A variable that is measured/observed (e.g., measured current)."@en .

lapet:Parameter a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Parameter"@en ;
  rdfs:comment "A contextual/static value recorded for a run/specification (e.g., geometry, thickness, width)."@en .

lapet:ElectricalVariable a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Electrical variable"@en .

lapet:MagneticVariable a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Magnetic variable"@en .

lapet:ThermalVariable a owl:Class ;
  rdfs:subClassOf lapet:Variable ;
  rdfs:label "Thermal variable"@en .

lapet:MeasurementRelation a owl:Class ;
  rdfs:label "Measurement relation"@en ;
  rdfs:comment "A relation asserted by the technique (e.g., functional dependence, correlation, threshold relation)."@en .

lapet:FunctionalDependence a owl:Class ;
  rdfs:subClassOf lapet:MeasurementRelation ;
  rdfs:label "Functional dependence"@en .

lapet:Channel a owl:Class ;
  rdfs:label "Channel"@en ;
  rdfs:comment "A data acquisition channel/stream. Channels are assigned semantic meaning via Variable assignments."@en .

lapet:DeviceUnderTest a owl:Class ;
  rdfs:label "Device under test"@en ;
  rdfs:comment "The device/sample that the experiment is performed on."@en .

#################################################################
# Technique / type hierarchy (starter)
#################################################################

lapet:ElectricalTransportExperiment a owl:Class ;
  rdfs:subClassOf lapet:ExperimentType ;
  rdfs:label "Electrical transport experiment"@en .

lapet:IVExperiment a owl:Class ;
  rdfs:subClassOf lapet:ElectricalTransportExperiment ;
  rdfs:label "IV experiment"@en ;
  rdfs:comment "Current–voltage experiment (IV). May have 2-point and 4-point specifications."@en .

#################################################################
# Properties
#################################################################

lapet:hasExperimentType a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:ExperimentType ;
  rdfs:label "has experiment type"@en .

lapet:hasSpecification a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:MeasurementSpecification ;
  rdfs:label "has specification"@en .

lapet:hasControlVariable a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:ControlVariable ;
  rdfs:label "has control variable"@en .

lapet:measuresObservable a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:Observable ;
  rdfs:label "measures observable"@en .

lapet:hasParameter a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:Parameter ;
  rdfs:label "has parameter"@en .

lapet:assertsRelation a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:MeasurementRelation ;
  rdfs:label "asserts relation"@en .

lapet:hasIndependentSemantics a owl:ObjectProperty ;
  rdfs:domain lapet:MeasurementRelation ;
  rdfs:range  lapet:Variable ;
  rdfs:label "has independent semantics"@en .

lapet:hasDependentSemantics a owl:ObjectProperty ;
  rdfs:domain lapet:MeasurementRelation ;
  rdfs:range  lapet:Variable ;
  rdfs:label "has dependent semantics"@en .

lapet:assignedChannel a owl:ObjectProperty ;
  rdfs:domain lapet:Variable ;
  rdfs:range  lapet:Channel ;
  rdfs:label "assigned channel"@en ;
  rdfs:comment "Links a semantic variable to the DAQ channel that provides its data in a given run context."@en .

lapet:appliesToDevice a owl:ObjectProperty ;
  rdfs:domain lapet:Experiment ;
  rdfs:range  lapet:DeviceUnderTest ;
  rdfs:label "applies to device"@en .

# Optional alignment hook: connect LAP-ET variables to standard quantity kinds (QUDT)
lapet:hasQuantityKind a owl:ObjectProperty ;
  rdfs:domain lapet:Variable ;
  rdfs:range  qudt:QuantityKind ;
  rdfs:label "has quantity kind"@en .

#################################################################
# Starter individuals (variables and specs)
#################################################################

# Variables (canonical semantics)
lapet:AppliedVoltage a owl:NamedIndividual, lapet:ControlVariable, lapet:ElectricalVariable ;
  rdfs:label "Applied voltage"@en ;
  lapet:hasQuantityKind quantitykind:Voltage .

lapet:MeasuredCurrent a owl:NamedIndividual, lapet:Observable, lapet:ElectricalVariable ;
  rdfs:label "Measured current"@en ;
  lapet:hasQuantityKind quantitykind:ElectricCurrent .

lapet:MeasuredVoltageDrop a owl:NamedIndividual, lapet:Observable, lapet:ElectricalVariable ;
  rdfs:label "Measured voltage drop"@en ;
  rdfs:comment "Measured voltage drop across the device (used as the independent variable in 4-point IV)."@en ;
  lapet:hasQuantityKind quantitykind:Voltage .

lapet:MeasuredTemperature a owl:NamedIndividual, lapet:Observable, lapet:ThermalVariable ;
  rdfs:label "Measured temperature"@en ;
  lapet:hasQuantityKind quantitykind:Temperature .

# Specifications (templates)
lapet:TwoPointIVSpecification a owl:NamedIndividual, lapet:MeasurementSpecification ;
  rdfs:label "2-point IV specification"@en ;
  rdfs:comment "Template for 2-point IV: control AppliedVoltage, measure MeasuredCurrent, optionally record MeasuredTemperature."@en .

lapet:FourPointIVSpecification a owl:NamedIndividual, lapet:MeasurementSpecification ;
  rdfs:label "4-point IV specification"@en ;
  rdfs:comment "Template for 4-point IV: control AppliedVoltage (often), measure MeasuredCurrent and MeasuredVoltageDrop, optionally record MeasuredTemperature."@en .

#################################################################
# SHACL shapes (validation / template requirements)
#################################################################

# Shape for an IV experiment run using the 2-point specification
lapet:TwoPointIVRunShape a sh:NodeShape ;
  sh:targetClass lapet:ExperimentRun ;
  rdfs:label "2-point IV run shape"@en ;
  sh:message "A 2-point IV run must select TwoPointIVSpecification and include required variables."@en ;

  # Must have IV experiment type
  sh:property [
    sh:path lapet:hasExperimentType ;
    sh:hasValue lapet:IVExperiment ;
    sh:minCount 1 ;
    sh:message "2-point IV run must have experiment type IVExperiment."@en ;
  ] ;

  # Must select TwoPointIVSpecification
  sh:property [
    sh:path lapet:hasSpecification ;
    sh:hasValue lapet:TwoPointIVSpecification ;
    sh:minCount 1 ;
    sh:message "2-point IV run must have specification TwoPointIVSpecification."@en ;
  ] ;

  # Required control variable: AppliedVoltage (exactly 1 occurrence in metadata)
  sh:property [
    sh:path lapet:hasControlVariable ;
    sh:hasValue lapet:AppliedVoltage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "2-point IV run must include exactly one control variable: AppliedVoltage."@en ;
  ] ;

  # Required observable: MeasuredCurrent (exactly 1 occurrence in metadata)
  sh:property [
    sh:path lapet:measuresObservable ;
    sh:hasValue lapet:MeasuredCurrent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "2-point IV run must include exactly one observable: MeasuredCurrent."@en ;
  ] ;

  # Optional observable: MeasuredTemperature (0..1)
  sh:property [
    sh:path lapet:measuresObservable ;
    sh:qualifiedValueShape [ sh:hasValue lapet:MeasuredTemperature ] ;
    sh:qualifiedMinCount 0 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "2-point IV run may include MeasuredTemperature at most once."@en ;
  ] .

# Shape for an IV experiment run using the 4-point specification
lapet:FourPointIVRunShape a sh:NodeShape ;
  sh:targetClass lapet:ExperimentRun ;
  rdfs:label "4-point IV run shape"@en ;
  sh:message "A 4-point IV run must select FourPointIVSpecification and include required variables."@en ;

  # Must have IV experiment type
  sh:property [
    sh:path lapet:hasExperimentType ;
    sh:hasValue lapet:IVExperiment ;
    sh:minCount 1 ;
    sh:message "4-point IV run must have experiment type IVExperiment."@en ;
  ] ;

  # Must select FourPointIVSpecification
  sh:property [
    sh:path lapet:hasSpecification ;
    sh:hasValue lapet:FourPointIVSpecification ;
    sh:minCount 1 ;
    sh:message "4-point IV run must have specification FourPointIVSpecification."@en ;
  ] ;

  # Required control variable (common pattern): AppliedVoltage (0..1 or 1..1 depends on setup)
  # Here we require it once; if some setups force current instead, we can generalize later.
  sh:property [
    sh:path lapet:hasControlVariable ;
    sh:hasValue lapet:AppliedVoltage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "4-point IV run must include exactly one control variable: AppliedVoltage (revise if your setup forces current instead)."@en ;
  ] ;

  # Required observables: MeasuredCurrent and MeasuredVoltageDrop
  sh:property [
    sh:path lapet:measuresObservable ;
    sh:hasValue lapet:MeasuredCurrent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "4-point IV run must include exactly one observable: MeasuredCurrent."@en ;
  ] ;

  sh:property [
    sh:path lapet:measuresObservable ;
    sh:hasValue lapet:MeasuredVoltageDrop ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "4-point IV run must include exactly one observable: MeasuredVoltageDrop."@en ;
  ] ;

  # Optional observable: MeasuredTemperature (0..1)
  sh:property [
    sh:path lapet:measuresObservable ;
    sh:qualifiedValueShape [ sh:hasValue lapet:MeasuredTemperature ] ;
    sh:qualifiedMinCount 0 ;
    sh:qualifiedMaxCount 1 ;
    sh:message "4-point IV run may include MeasuredTemperature at most once."@en ;
  ] .

#################################################################
# (Optional) Example run instance (for illustration/testing)
#################################################################

lapet:example_run_2p a lapet:ExperimentRun ;
  rdfs:label "Example 2-point IV run"@en ;
  lapet:hasExperimentType lapet:IVExperiment ;
  lapet:hasSpecification lapet:TwoPointIVSpecification ;
  lapet:hasControlVariable lapet:AppliedVoltage ;
  lapet:measuresObservable lapet:MeasuredCurrent ;
  lapet:measuresObservable lapet:MeasuredTemperature .
