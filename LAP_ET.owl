<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET/"
     xml:base="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET">
        <rdfs:comment>An LAP experimental techniques ontology</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasContactGeometry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasContactGeometry">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isContactGeometryOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ContactGeometry"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isControlVariableOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasMeasuredObservable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasMeasuredObservable">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isMeasuredObservableOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasSpecification -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasSpecification">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isSpecificationOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MeasurementSpecification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isContactGeometryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isContactGeometryOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isControlVariableOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isControlVariableOf"/>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isMeasuredObservableOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isMeasuredObservableOf"/>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isQuantityOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isQuantityOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isSpecificationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#isSpecificationOf"/>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ContactGeometry -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ContactGeometry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MeasurementSpecification"/>
        <rdfs:comment>A subclass of measurement specifications defining the electric contact geometry of a solid-state device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalQuantity"/>
        <rdfs:comment>A subclass of electrical quantities that describes the strength of an electric current flowing through a solid-state device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalQuantity"/>
        <rdfs:comment>A subclass of electrical quantities that describes the strength of an applied electric potential difference inside a solid-state device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricTransportExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricTransportExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate the dynamics of charge carriers in a solid-state device by applying and/or measuring electric quantities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate a solid-state device via its electrical response by applying and/or measureing electrical quantities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalQuantity -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalQuantity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
        <rdfs:comment>A subclass of physical quantities that are measurable and/or applicable quantities associated with the presence, motion, or interaction of electric charge in a solid-state device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectroopticalExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectroopticalExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate the coupling between electrical excitation/fields and optical response (or vice versa) of a solid-state device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ExternalMagneticField -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ExternalMagneticField">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
        <rdfs:comment>A subclass of physical quantities that describes the strength of an applied external magnetic field during an LAP experiment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#FourTerminalContactGeometry -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#FourTerminalContactGeometry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ContactGeometry"/>
        <rdfs:comment>A subclass of contact geometries with four electrical contacts</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#FourTerminalIVExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#FourTerminalIVExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#IVExperiment"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#Temperature"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasContactGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#FourTerminalContactGeometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasMeasuredObservable"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A subclass of IV experiments that use the 4-terminal device geometry, measuring a longitudinal voltage drop across the device under applied device current/voltage</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#HallExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#HallExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricTransportExperiment"/>
        <rdfs:comment>A subclass of electric transport experiments that investigate electric transport in a solid-state device via the Hall effect by measuring voltage drops across the device under applied device current/voltage and external magnetic field.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#IVExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#IVExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricTransportExperiment"/>
        <rdfs:comment>A subclass of electric transport experiments that investigate electric transport in a solid-state device by measuring a device current / voltage drop or device voltage / device current relation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MeasurementSpecification"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
        <rdfs:comment>A class of experiments that are performed at the chair of applied physics at Friedrich-Alexander Universität Erlangen/Nürnberg</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ElectricalQuantity"/>
        <rdfs:comment>A subclass of electrical quantities that describes the strength of an emergent electric potential difference along the long axis of a solid-state device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MagneticExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MagneticExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate a solid-state device via its magnetic or spin response by applying and/or measuring magnetic quantities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MagnetoopticalExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MagnetoopticalExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate the coupling between magnetic/spin states and optical properties of a solid-state device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MeasurementSpecification -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#MeasurementSpecification">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity"/>
        <rdfs:comment>A class of specifications for LAP experiments</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#OpticalExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#OpticalExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LAPExperiment"/>
        <rdfs:comment>A subclass of LAP experiments that investigate a solid-state device via its interaction with light by applying and/or measuring optical quantities</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#PhysicalQuantity">
        <rdfs:comment>A class of physical quantities applied and/or measured in an LAP experiment</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#SixTerminalContactGeometry -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#SixTerminalContactGeometry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ContactGeometry"/>
        <rdfs:comment>A subclass of contact geometries with six electrical contacts</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#SixTerminalHallExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#SixTerminalHallExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#HallExperiment"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasControlVariable"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ExternalMagneticField"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasMeasuredObservable"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#hasMeasuredObservable"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#VerticalVoltageDrop"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceCurrent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#DeviceVoltage"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#ExternalMagneticField"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#LongitudinalVoltageDrop"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#Temperature"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#relatesToQuantity"/>
