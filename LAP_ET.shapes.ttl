@prefix lapet: <http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/yd27ovas/ontologies/2026/1/LAP_ET/shapes>
        rdf:type      owl:Ontology;
        rdfs:comment  "SHACL validation shapes for LAP_ET standardized experiment profiles." .

lapet:SixTerminalHallRunShape
        rdf:type        sh:NodeShape;
        sh:targetClass  lapet:SixTerminalHallRun;
        sh:message      "Six-terminal Hall runs must follow SixTerminalHallSpecificationV1 and provide complete channel-mapped required semantics.";
        sh:property     [ rdf:type     sh:PropertyShape;
                          sh:path      lapet:hasExperimentType;
                          sh:hasValue  lapet:SixTerminalHallExperiment;
                          sh:minCount  "1"^^xsd:integer;
                          sh:maxCount  "1"^^xsd:integer;
                          sh:message   "Run must declare exactly one experiment type: SixTerminalHallExperiment."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasSpecification;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class  lapet:SixTerminalHallSpecificationV1
                                                  ];
                          sh:maxCount             "1"^^xsd:integer;
                          sh:message              "Exactly one SixTerminalHallSpecificationV1 instance must be linked via hasSpecification."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasContactGeometry;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class  lapet:SixTerminalContactGeometry
                                                  ];
                          sh:maxCount             "1"^^xsd:integer;
                          sh:message              "Exactly one six-terminal contact geometry must be linked via hasContactGeometry."
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          sh:path      lapet:hasControlVariable;
                          sh:minCount  "2"^^xsd:integer;
                          sh:maxCount  "2"^^xsd:integer;
                          sh:message   "Controls must be exactly two values."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasControlVariable;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class     lapet:ExternalMagneticField;
                                                    sh:property  [ sh:path      lapet:assignedChannel;
                                                                   sh:minCount  "1"^^xsd:integer;
                                                                   sh:maxCount  "1"^^xsd:integer
                                                                 ]
                                                  ];
                          sh:message              "ExternalMagneticField must appear exactly once and map to exactly one channel."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasControlVariable;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class     lapet:CurrentOrVoltageControl;
                                                    sh:property  [ sh:path      lapet:assignedChannel;
                                                                   sh:minCount  "1"^^xsd:integer;
                                                                   sh:maxCount  "1"^^xsd:integer
                                                                 ]
                                                  ];
                          sh:message              "Exactly one current/voltage control must be present and mapped to exactly one channel."
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          sh:path      lapet:hasMeasuredObservable;
                          sh:minCount  "2"^^xsd:integer;
                          sh:maxCount  "3"^^xsd:integer;
                          sh:message   "Observables must include longitudinal and vertical voltage drop, with optional temperature."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasMeasuredObservable;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class     lapet:LongitudinalVoltageDrop;
                                                    sh:property  [ sh:path      lapet:assignedChannel;
                                                                   sh:minCount  "1"^^xsd:integer;
                                                                   sh:maxCount  "1"^^xsd:integer
                                                                 ]
                                                  ];
                          sh:message              "LongitudinalVoltageDrop must appear exactly once and map to exactly one channel."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasMeasuredObservable;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "1"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class     lapet:VerticalVoltageDrop;
                                                    sh:property  [ sh:path      lapet:assignedChannel;
                                                                   sh:minCount  "1"^^xsd:integer;
                                                                   sh:maxCount  "1"^^xsd:integer
                                                                 ]
                                                  ];
                          sh:message              "VerticalVoltageDrop must appear exactly once and map to exactly one channel."
                        ];
        sh:property     [ rdf:type                sh:PropertyShape;
                          sh:path                 lapet:hasMeasuredObservable;
                          sh:qualifiedMaxCount    "1"^^xsd:integer;
                          sh:qualifiedMinCount    "0"^^xsd:integer;
                          sh:qualifiedValueShape  [ sh:class     lapet:Temperature;
                                                    sh:property  [ sh:path      lapet:assignedChannel;
                                                                   sh:minCount  "1"^^xsd:integer;
                                                                   sh:maxCount  "1"^^xsd:integer
                                                                 ]
                                                  ];
                          sh:message              "If Temperature is present, it must map to exactly one channel."
                        ] .
